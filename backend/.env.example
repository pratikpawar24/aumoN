# ── Core (required) ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aumo?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# Public URL of the frontend (used in email links + CORS). On Render set this
# to your deployed frontend URL.
FRONTEND_URL=https://aumo-frontend.vercel.app

# ── Services ─────────────────────────────────────────────────────────────────
AI_SERVICE_URL=https://pratikpawar24-aumo-ai.hf.space
ORS_API_KEY=your_openrouteservice_api_key

# ── Email / OTP verification (Brevo) ─────────────────────────────────────────
# Get the API key: Brevo dashboard → Settings → SMTP & API → API Keys.
# It must start with "xkeysib-".
BREVO_API_KEY=xkeysib-your-actual-api-key-here
# The sender address. MUST be verified in Brevo (Senders → Add a sender →
# confirm the email) or sends are rejected with a 400 "sender not valid".
BREVO_SENDER_EMAIL=admin.aumo@gmail.com
BREVO_SENDER_NAME=AumoN Team
# OTP tuning (optional — these are the defaults).
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Optional SMTP fallback (used only if BREVO_API_KEY is unset). EMAIL_FROM is a
# legacy alias for the sender if BREVO_SENDER_EMAIL is not set.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=AumoN Team <admin.aumo@gmail.com>

# ── Optional integrations ────────────────────────────────────────────────────
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>
# TOMTOM_API_KEY=
# OPENWEATHER_API_KEY=
# TOLLGURU_API_KEY=

# ── Master admin seeding (optional) ──────────────────────────────────────────
# ADMIN_EMAIL=admin@aumon.app
# ADMIN_PASSWORD=change_me_strong
# ADMIN_NAME=AumoN Master Admin
