{
  "expo": {
    "name": "AumoN",
    "slug": "aumon-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aumon.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AumoN uses your location to plan routes and track trips."
      }
    },
    "android": {
      "package": "com.aumon.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AumoN uses your location to plan routes and track trips."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AumoN needs access to your photos so you can set a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22c55e"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://aumo-backend-h82m.onrender.com",
      "eas": {
        "projectId": "REPLACE_VIA_eas_init"
      }
    }
  }
}
